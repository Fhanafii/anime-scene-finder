# Application Environment Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/anime_scene_finder
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=anime-keyframes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=anime_scene_finder

# Embedding Model Configuration
EMBEDDING_MODEL=openclip
EMBEDDING_MODEL_NAME=ViT-B-32
EMBEDDING_PRETRAINED=openai
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# Search Configuration
SEARCH_TOP_K=50
SEARCH_RESULT_LIMIT=10
SEARCH_MAX_IMAGE_BYTES=10485760

# Host ports; container-to-container ports remain fixed.
API_PORT=8010
POSTGRES_PORT=5435
REDIS_PORT=6380
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9003
